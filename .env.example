# 🦙 Llama Player — Configuração do Google Drive
#
# Para usar a integração com Google Drive, você precisa:
# 1. Acessar https://console.cloud.google.com/apis/credentials
# 2. Criar um projeto (ou selecionar existente)
# 3. Ativar a "Google Drive API" em Biblioteca de APIs
# 4. Para o app desktop Tauri, criar uma credencial
#    "OAuth 2.0 Client ID" do tipo "Desktop app"
# 5. Para rodar apenas no navegador com Vite, usar um Client ID de "Aplicativo Web"
#    com http://localhost:1420 como origem JavaScript autorizada
# 6. Copiar o Client ID para a variável abaixo

VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Opcional. Alguns clientes OAuth desktop legados do Google podem exigir secret
# na troca do authorization code. Use apenas se o endpoint retornar esse erro.
# VITE_GOOGLE_CLIENT_SECRET=seu-client-secret
