{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Llama Player",
  "version": "0.1.0",
  "identifier": "com.llamaplayer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "🦙 Llama Player",
        "width": 480,
        "height": 680,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://accounts.google.com https://apis.google.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https://www.googleapis.com data:; connect-src 'self' https://www.googleapis.com https://accounts.google.com https://oauth2.googleapis.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNzcwMEM0RThENTJCQ0YKUldUUEs5WG94QUIzUVRnOFVMMEpXZnhhNThkZ0ZRMUYvYWQ1cGN2MngvN3EwM0lBNEdNaUJXbzgK",
      "endpoints": [
        "https://github.com/N1ghthill/llama-player/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
