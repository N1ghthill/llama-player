    1 | /**
    2 |  * 🦙 Llama Player — Google Drive Service
    3 |  *
    4 |  * Serviço para autenticação OAuth 2.0, listagem de arquivos e streaming
    5 |  * de áudio do Google Drive.
    6 |  *
    7 |  * Usa Google Identity Services (GIS) para OAuth com PKCE.
    8 |  * Em ambiente Tauri, usará @tauri-apps/api para armazenamento seguro.
    9 |  */
   10 | 
   11 | // Escopos necessários para a aplicação
   12 | const SCOPES = [
   13 |   "https://www.googleapis.com/auth/drive.readonly",
   14 |   "https://www.googleapis.com/auth/userinfo.email",
   15 |   "https://www.googleapis.com/auth/userinfo.profile",
   16 | ].join(" ");
   17 | 
   18 | const DISCOVERY_DOC =
   19 |   "https://www.googleapis.com/discovery/v1/apis/drive/v3/rest";
   20 | 
   21 | // Tipos de áudio suportados para filtrar no Drive
   22 | const AUDIO_MIME_TYPES = new Set([
   23 |   "audio/mpeg",
   24 |   "audio/mp3",
   25 |   "audio/flac",
   26 |   "audio/ogg",
   27 |   "audio/wav",
   28 |   "audio/x-wav",
   29 |   "audio/aac",
   30 |   "audio/mp4",
   31 |   "audio/x-m4a",
   32 |   "audio/webm",
   33 | ]);
   34 | 
   35 | // Extensões de áudio para filtrar quando o MIME type não é suficiente
   36 | const AUDIO_EXTENSIONS = new Set([
   37 |   ".mp3",
   38 |   ".flac",
   39 |   ".ogg",
   40 |   ".wav",
   41 |   ".aac",
   42 |   ".m4a",
   43 |   ".wma",
   44 |   ".opus",
   45 |   ".webm",
   46 | ]);
   47 | 
   48 | export interface DriveFile {
   49 |   id: string;
   50 |   name: string;
   51 |   mimeType: string;
   52 |   size?: number;
   53 |   modifiedTime?: string;
   54 |   parents?: string[];
   55 |   iconLink?: string;
   56 |   /** Duração estimada em segundos (não vem do Drive, calculamos depois) */
   57 |   duration?: number;
   58 |   /** URL de download temporário */
   59 |   downloadUrl?: string;
   60 |   /** Web Content Link para streaming */
   61 |   webContentLink?: string;
   62 | }
   63 | 
   64 | export interface DriveFolder {
   65 |   id: string;
   66 |   name: string;
   67 |   mimeType: string;
   68 |   parents?: string[];
   69 | }
   70 | 
   71 | export type DriveItem = DriveFile | DriveFolder;
   72 | 
   73 | export interface DriveUser {
   74 |   email: string;
   75 |   name: string;
   76 |   picture?: string;
   77 | }
   78 | 
   79 | export interface DriveState {
   80 |   isAuthenticated: boolean;
   81 |   isLoading: boolean;
   82 |   user: DriveUser | null;
   83 |   currentFolder: DriveFolder | null;
   84 |   breadcrumbs: DriveFolder[];
   85 |   items: DriveItem[];
   86 |   error: string | null;
   87 | }
   88 | 
   89 | /** Configuração do cache de listas do Drive */
   90 | export interface DriveCacheConfig {
   91 |   /** Tempo de vida do cache em milissegundos (padrão: 5 minutos) */
   92 |   ttl: number;
   93 |   /** Máximo de entradas no cache */
   94 |   maxEntries: number;
   95 | }
   96 | 
   97 | const DEFAULT_CACHE_CONFIG: DriveCacheConfig = {
   98 |   ttl: 5 * 60 * 1000, // 5 minutos
   99 |   maxEntries: 50,
  100 | };
  101 | 
  102 | interface CacheEntry {
  103 |   items: DriveItem[];
  104 |   timestamp: number;
  105 |   folderId: string | null;
  106 | }
  107 | 
  108 | /** Informações de uma playlist sincronizada com uma pasta do Drive */
  109 | export interface SyncedPlaylist {
  110 |   folderId: string;
  111 |   folderName: string;
  112 |   trackIds: string[]; // driveFileId de cada track
  113 |   syncedAt: string; // ISO date
  114 | }
  115 | 
  116 | export function isFolder(item: DriveItem): item is DriveFolder {
  117 |   return item.mimeType === "application/vnd.google-apps.folder";
  118 | }
  119 | 
  120 | export function isAudioFile(item: DriveItem): item is DriveFile {
  121 |   if (isFolder(item)) return false;
  122 |   const file = item as DriveFile;
  123 |   if (AUDIO_MIME_TYPES.has(file.mimeType)) return true;
  124 |   // Fallback: verificar extensão do nome
  125 |   const ext = file.name.toLowerCase().slice(file.name.lastIndexOf("."));
  126 |   return AUDIO_EXTENSIONS.has(ext);
  127 | }
  128 | 
  129 | /**
  130 |  * Classe principal do serviço Google Drive.
  131 |  * Gerencia token OAuth, requisições à API e streaming.
  132 |  */
  133 | export class GoogleDriveService {
  134 |   private accessToken: string | null = null;
  135 |   private tokenClient: any = null;
  136 |   private gisLoaded: boolean = false;
  137 | 
  138 |   // Cache de listas de arquivos
  139 |   private listCache: Map<string, CacheEntry> = new Map();
  140 |   private cacheConfig: DriveCacheConfig = { ...DEFAULT_CACHE_CONFIG };
  141 | 
  142 |   constructor() {
  143 |     this.loadGisApi();
  144 |   }
  145 | 
  146 |   /**
  147 |    * Configura o cache de listas.
  148 |    */
  149 |   setCacheConfig(config: Partial<DriveCacheConfig>): void {
  150 |     this.cacheConfig = { ...this.cacheConfig, ...config };
  151 |   }
  152 | 
  153 |   /**
  154 |    * Limpa o cache de listas.
  155 |    */
  156 |   clearCache(): void {
  157 |     this.listCache.clear();
  158 |   }
  159 | 
  160 |   /**
  161 |    * Invalida entradas expiradas do cache.
  162 |    */
  163 |   private cleanExpiredCache(): void {
  164 |     const now = Date.now();
  165 |     for (const [key, entry] of this.listCache.entries()) {
  166 |       if (now - entry.timestamp > this.cacheConfig.ttl) {
  167 |         this.listCache.delete(key);
  168 |       }
  169 |     }
  170 |   }
  171 | 
  172 |   /**
  173 |    * Gera chave de cache para uma pasta.
  174 |    */
  175 |   private cacheKey(folderId: string | null): string {
  176 |     return folderId ?? "__root__";
  177 |   }
  178 | 
  179 |   /**
  180 |    * Obtém itens do cache se válidos.
  181 |    */
  182 |   private getCachedItems(folderId: string | null): DriveItem[] | null {
  183 |     this.cleanExpiredCache();
  184 |     const key = this.cacheKey(folderId);
  185 |     const entry = this.listCache.get(key);
  186 |     if (!entry) return null;
  187 |     if (Date.now() - entry.timestamp > this.cacheConfig.ttl) {
  188 |       this.listCache.delete(key);
  189 |       return null;
  190 |     }
  191 |     return entry.items;
  192 |   }
  193 | 
  194 |   /**
  195 |    * Armazena itens no cache.
  196 |    */
  197 |   private setCachedItems(folderId: string | null, items: DriveItem[]): void {
  198 |     const key = this.cacheKey(folderId);
  199 |     this.listCache.set(key, {
  200 |       items,
  201 |       timestamp: Date.now(),
  202 |       folderId,
  203 |     });
  204 |     // Limita o tamanho do cache removendo entradas mais antigas
  205 |     if (this.listCache.size > this.cacheConfig.maxEntries) {
  206 |       const oldest = this.listCache.entries().next().value;
  207 |       if (oldest) this.listCache.delete(oldest[0]);
  208 |     }
  209 |   }
  210 | 
  211 |   /**
  212 |    * Carrega a API Google Identity Services dinamicamente.
  213 |    */
  214 |   private loadGisApi(): void {
  215 |     if (typeof google !== "undefined" && google.accounts) {
  216 |       this.gisLoaded = true;
  217 |       return;
  218 |     }
  219 | 
  220 |     const script = document.createElement("script");
  221 |     script.src = "https://accounts.google.com/gsi/client";
  222 |     script.async = true;
  223 |     script.defer = true;
  224 |     script.onload = () => {
  225 |       this.gisLoaded = true;
  226 |       console.log("[Llama Player] GIS API carregada");
  227 |     };
  228 |     script.onerror = () => {
  229 |       console.error("[Llama Player] Erro ao carregar GIS API");
  230 |     };
  231 |     document.head.appendChild(script);
  232 |   }
  233 | 
  234 |   /**
  235 |    * Carrega a API Discovery do Google Drive.
  236 |    */
  237 |   private async loadDriveApi(): Promise<void> {
  238 |     return new Promise((resolve, reject) => {
  239 |       if (typeof gapi !== "undefined" && gapi.client) {
  240 |         resolve();
  241 |         return;
  242 |       }
  243 | 
  244 |       const script = document.createElement("script");
  245 |       script.src = "https://apis.google.com/js/api.js";
  246 |       script.async = true;
  247 |       script.defer = true;
  248 |       script.onload = () => {
  249 |         (gapi as any).load("client", async () => {
  250 |           try {
  251 |             await (gapi as any).client.init({});
  252 |             await (gapi as any).client.load(DISCOVERY_DOC);
  253 |             resolve();
  254 |           } catch (err) {
  255 |             reject(err);
  256 |           }
  257 |         });
  258 |       };
  259 |       script.onerror = () => reject(new Error("Erro ao carregar Google API"));
  260 |       document.head.appendChild(script);
  261 |     });
  262 |   }
  263 | 
  264 |   /**
  265 |    * Inicializa o TokenClient com o Client ID.
  266 |    * Deve ser chamado após o usuário interagir (clicar em "Login").
  267 |    */
  268 |   async initialize(clientId: string): Promise<void> {
  269 |     // Aguarda GIS carregar
  270 |     while (!this.gisLoaded) {
  271 |       await new Promise((r) => setTimeout(r, 100));
  272 |     }
  273 | 
  274 |     this.tokenClient = (google as any).accounts.oauth2.initTokenClient({
  275 |       client_id: clientId,
  276 |       scope: SCOPES,
  277 |       callback: (response: any) => {
  278 |         if (response.access_token) {
  279 |           this.accessToken = response.access_token;
  280 |           this.storeToken(response.access_token);
  281 |         }
  282 |       },
  283 |     });
  284 | 
  285 |     // Carrega Drive API
  286 |     await this.loadDriveApi();
  287 |   }
  288 | 
  289 |   /**
  290 |    * Dispara o fluxo de login OAuth.
  291 |    * Retorna true se autenticou com sucesso.
  292 |    */
  293 |   async login(): Promise<boolean> {
  294 |     if (!this.tokenClient) {
  295 |       throw new Error(
  296 |         "TokenClient não inicializado. Chame initialize(clientId) primeiro."
  297 |       );
  298 |     }
  299 | 
  300 |     return new Promise((resolve) => {
  301 |       this.tokenClient!.callback = (response: any) => {
  302 |         if (response.access_token) {
  303 |           this.accessToken = response.access_token;
  304 |           this.storeToken(response.access_token);
  305 |           resolve(true);
  306 |         } else {
  307 |           console.error("[Llama Player] Erro no OAuth:", response.error);
  308 |           resolve(false);
  309 |         }
  310 |       };
  311 | 
  312 |       // Solicita token (pode abrir popup)
  313 |       this.tokenClient!.requestAccessToken({ prompt: "consent" });
  314 |     });
  315 |   }
  316 | 
  317 |   /**
  318 |    * Tenta fazer login silencioso com token existente.
  319 |    */
  320 |   async trySilentLogin(clientId: string): Promise<boolean> {
  321 |     const storedToken = this.getStoredToken();
  322 |     if (!storedToken) return false;
  323 | 
  324 |     this.accessToken = storedToken;
  325 | 
  326 |     try {
  327 |       await this.initialize(clientId);
  328 |       // Verifica se o token ainda é válido
  329 |       const user = await this.getUserInfo();
  330 |       return !!user;
  331 |     } catch {
  332 |       this.accessToken = null;
  333 |       this.clearToken();
  334 |       return false;
  335 |     }
  336 |   }
  337 | 
  338 |   /**
  339 |    * Faz logout: limpa token e revoga.
  340 |    */
  341 |   async logout(): Promise<void> {
  342 |     if (this.accessToken) {
  343 |       try {
  344 |         (google as any).accounts.oauth2.revoke(this.accessToken, () => {});
  345 |       } catch {
  346 |         // Ignora erro no revoke
  347 |       }
  348 |     }
  349 |     this.accessToken = null;
  350 |     this.clearToken();
  351 |   }
  352 | 
  353 |   /**
  354 |    * Retorna informações do usuário autenticado.
  355 |    */
  356 |   async getUserInfo(): Promise<DriveUser | null> {
  357 |     if (!this.accessToken) return null;
  358 | 
  359 |     try {
  360 |       const response = await fetch(
  361 |         "https://www.googleapis.com/oauth2/v2/userinfo",
  362 |         {
  363 |           headers: { Authorization: `Bearer ${this.accessToken}` },
  364 |         }
  365 |       );
  366 |       if (!response.ok) return null;
  367 |       const data = await response.json();
  368 |       return {
  369 |         email: data.email,
  370 |         name: data.name,
  371 |         picture: data.picture,
  372 |       };
  373 |     } catch {
  374 |       return null;
  375 |     }
  376 |   }
  377 | 
  378 |   /**
  379 |    * Lista arquivos e pastas em uma pasta do Drive.
  380 |    * Se folderId for null, lista a raiz.
  381 |    * Utiliza cache para evitar requisições repetidas.
  382 |    */
  383 |   async listFiles(
  384 |     folderId: string | null = null,
  385 |     bypassCache: boolean = false
  386 |   ): Promise<DriveItem[]> {
  387 |     if (!this.accessToken) throw new Error("Não autenticado");
  388 | 
  389 |     // Verifica cache primeiro
  390 |     if (!bypassCache) {
  391 |       const cached = this.getCachedItems(folderId);
  392 |       if (cached) {
  393 |         console.debug("[Llama Player] Usando cache para pasta:", folderId ?? "root");
  394 |         return cached;
  395 |       }
  396 |     }
  397 | 
  398 |     const query = folderId
  399 |       ? `'${folderId}' in parents and trashed = false`
  400 |       : "trashed = false and 'root' in parents";
  401 | 
  402 |     const fields =
  403 |       "files(id,name,mimeType,size,modifiedTime,parents,iconLink,webContentLink)";
  404 | 
  405 |     try {
  406 |       const response = await (gapi as any).client.drive.files.list({
  407 |         q: query,
  408 |         fields,
  409 |         orderBy: "folder,name",
  410 |         pageSize: 100,
  411 |         includeItemsFromAllDrives: false,
  412 |         supportsAllDrives: false,
  413 |       });
  414 | 
  415 |       const files = response.result.files || [];
  416 |       const items: DriveItem[] = files.map((file: any) => ({
  417 |         id: file.id,
  418 |         name: file.name,
  419 |         mimeType: file.mimeType,
  420 |         size: file.size ? parseInt(file.size, 10) : undefined,
  421 |         modifiedTime: file.modifiedTime,
  422 |         parents: file.parents,
  423 |         iconLink: file.iconLink,
  424 |         webContentLink: file.webContentLink,
  425 |       }));
  426 | 
  427 |       // Armazena no cache
  428 |       this.setCachedItems(folderId, items);
  429 | 
  430 |       return items;
  431 |     } catch (err: any) {
  432 |       console.error("[Llama Player] Erro ao listar arquivos:", err);
  433 |       throw new Error(
  434 |         err?.result?.error?.message || "Erro ao listar arquivos do Drive"
  435 |       );
  436 |     }
  437 |   }
  438 | 
  439 |   /**
  440 |    * Busca arquivos de áudio no Drive por nome.
  441 |    */
  442 |   async searchAudio(query: string): Promise<DriveFile[]> {
  443 |     if (!this.accessToken) throw new Error("Não autenticado");
  444 | 
  445 |     const mimeFilter = Array.from(AUDIO_MIME_TYPES)
  446 |       .map((m) => `mimeType = '${m}'`)
  447 |       .join(" or ");
  448 | 
  449 |     const q = `(name contains '${query.replace(/'/g, "\\'")}') and (${mimeFilter}) and trashed = false`;
  450 | 
  451 |     try {
  452 |       const response = await (gapi as any).client.drive.files.list({
  453 |         q,
  454 |         fields:
  455 |           "files(id,name,mimeType,size,modifiedTime,parents,iconLink,webContentLink)",
  456 |         orderBy: "name",
  457 |         pageSize: 50,
  458 |       });
  459 | 
  460 |       return (response.result.files || []).map((file: any) => ({
  461 |         id: file.id,
  462 |         name: file.name,
  463 |         mimeType: file.mimeType,
  464 |         size: file.size ? parseInt(file.size, 10) : undefined,
  465 |         modifiedTime: file.modifiedTime,
  466 |         parents: file.parents,
  467 |         iconLink: file.iconLink,
  468 |         webContentLink: file.webContentLink,
  469 |       }));
  470 |     } catch (err: any) {
  471 |       console.error("[Llama Player] Erro na busca:", err);
  472 |       throw new Error(
  473 |         err?.result?.error?.message || "Erro ao buscar no Drive"
  474 |       );
  475 |     }
  476 |   }
  477 | 
  478 |   /**
  479 |    * Obtém URL de download direto para um arquivo do Drive.
  480 |    * Usa exportLinks para arquivos do Google Docs ou download para binários.
  481 |    */
  482 |   async getDownloadUrl(fileId: string, _mimeType: string): Promise<string> {
  483 |     if (!this.accessToken) throw new Error("Não autenticado");
  484 | 
  485 |     // Para arquivos de áudio, usa o download direto
  486 |     return `https://www.googleapis.com/drive/v3/files/${fileId}?alt=media`;
  487 |   }
  488 | 
  489 |   /**
  490 |    * Cria um URL de streaming com o token de acesso.
  491 |    * O token expira em 1 hora, então precisa renovar para músicas longas.
  492 |    */
  493 |   getStreamUrl(fileId: string): string {
  494 |     if (!this.accessToken) throw new Error("Não autenticado");
  495 |     return `https://www.googleapis.com/drive/v3/files/${fileId}?alt=media&access_token=${this.accessToken}`;
  496 |   }
  497 | 
  498 |   /**
  499 |    * Obtém um ReadableStream para um arquivo de áudio do Drive,
  500 |    * suportando Range requests para buffer progressivo.
  501 |    *
  502 |    * Útil para implementar streaming com fetch manual em vez de
  503 |    * depender do HTMLAudioElement com URL direta.
  504 |    */
  505 |   async streamFile(
  506 |     fileId: string,
  507 |     options?: { start?: number; end?: number }
  508 |   ): Promise<Response> {
  509 |     if (!this.accessToken) throw new Error("Não autenticado");
  510 | 
  511 |     const url = `https://www.googleapis.com/drive/v3/files/${fileId}?alt=media`;
  512 |     const headers: Record<string, string> = {
  513 |       Authorization: `Bearer ${this.accessToken}`,
  514 |     };
  515 | 
  516 |     if (options?.start !== undefined || options?.end !== undefined) {
  517 |       const start = options.start ?? 0;
  518 |       const end = options.end ?? "";
  519 |       headers["Range"] = `bytes=${start}-${end}`;
  520 |     }
  521 | 
  522 |     const response = await fetch(url, { headers });
  523 | 
  524 |     if (!response.ok && response.status !== 206) {
  525 |       throw new Error(
  526 |         `Erro no streaming do arquivo ${fileId}: ${response.status} ${response.statusText}`
  527 |       );
  528 |     }
  529 | 
  530 |     return response;
  531 |   }
  532 | 
  533 |   /**
  534 |    * Obtém metadados de um arquivo específico do Drive.
  535 |    * Útil para verificar tamanho antes de iniciar streaming.
  536 |    */
  537 |   async getFileMetadata(fileId: string): Promise<DriveFile> {
  538 |     if (!this.accessToken) throw new Error("Não autenticado");
  539 | 
  540 |     const response = await fetch(
  541 |       `https://www.googleapis.com/drive/v3/files/${fileId}?fields=id,name,mimeType,size,modifiedTime`,
  542 |       { headers: { Authorization: `Bearer ${this.accessToken}` } }
  543 |     );
  544 | 
  545 |     if (!response.ok) {
  546 |       throw new Error(
  547 |         `Erro ao obter metadados do arquivo ${fileId}: ${response.status}`
  548 |       );
  549 |     }
  550 | 
  551 |     const file = await response.json();
  552 |     return {
  553 |       id: file.id,
  554 |       name: file.name,
  555 |       mimeType: file.mimeType,
  556 |       size: file.size ? parseInt(file.size, 10) : undefined,
  557 |       modifiedTime: file.modifiedTime,
  558 |     };
  559 |   }
  560 | 
  561 |   /**
  562 |    * Verifica se o token atual é válido fazendo uma requisição leve.
  563 |    */
  564 |   async validateToken(): Promise<boolean> {
  565 |     if (!this.accessToken) return false;
  566 |     try {
  567 |       const response = await fetch(
  568 |         "https://www.googleapis.com/drive/v3/about?fields=user",
  569 |         { headers: { Authorization: `Bearer ${this.accessToken}` } }
  570 |       );
  571 |       return response.ok;
  572 |     } catch {
  573 |       return false;
  574 |     }
  575 |   }
  576 | 
  577 |   // --- Playlists Sincronizadas com Pastas do Drive ---
  578 | 
  579 |   private SYNCED_PLAYLISTS_KEY = "llama-player-synced-playlists";
  580 | 
  581 |   /**
  582 |    * Salva uma playlist sincronizada com uma pasta do Drive.
  583 |    */
  584 |   saveSyncedPlaylist(playlist: SyncedPlaylist): void {
  585 |     try {
  586 |       const stored = this.getSyncedPlaylists();
  587 |       const existingIndex = stored.findIndex(
  588 |         (p) => p.folderId === playlist.folderId
  589 |       );
  590 |       if (existingIndex >= 0) {
  591 |         stored[existingIndex] = playlist;
  592 |       } else {
  593 |         stored.push(playlist);
  594 |       }
  595 |       localStorage.setItem(this.SYNCED_PLAYLISTS_KEY, JSON.stringify(stored));
  596 |     } catch {
  597 |       // localStorage pode não estar disponível
  598 |     }
  599 |   }
  600 | 
  601 |   /**
  602 |    * Remove uma playlist sincronizada.
  603 |    */
  604 |   removeSyncedPlaylist(folderId: string): void {
  605 |     try {
  606 |       const stored = this.getSyncedPlaylists();
  607 |       const filtered = stored.filter((p) => p.folderId !== folderId);
  608 |       localStorage.setItem(
  609 |         this.SYNCED_PLAYLISTS_KEY,
  610 |         JSON.stringify(filtered)
  611 |       );
  612 |     } catch {
  613 |       // Ignora
  614 |     }
  615 |   }
  616 | 
  617 |   /**
  618 |    * Retorna todas as playlists sincronizadas.
  619 |    */
  620 |   getSyncedPlaylists(): SyncedPlaylist[] {
  621 |     try {
  622 |       const data = localStorage.getItem(this.SYNCED_PLAYLISTS_KEY);
  623 |       if (!data) return [];
  624 |       return JSON.parse(data);
  625 |     } catch {
  626 |       return [];
  627 |     }
  628 |   }
  629 | 
  630 |   /**
  631 |    * Sincroniza a playlist atual com uma pasta do Drive:
  632 |    * salva os IDs dos arquivos de áudio da pasta.
  633 |    */
  634 |   async syncPlaylistWithFolder(folderId: string, folderName: string): Promise<SyncedPlaylist> {
  635 |     const items = await this.listFiles(folderId, true); // bypass cache para garantir dados frescos
  636 |     const audioFiles = items.filter(isAudioFile) as DriveFile[];
  637 | 
  638 |     const synced: SyncedPlaylist = {
  639 |       folderId,
  640 |       folderName,
  641 |       trackIds: audioFiles.map((f) => f.id),
  642 |       syncedAt: new Date().toISOString(),
  643 |     };
  644 | 
  645 |     this.saveSyncedPlaylist(synced);
  646 |     return synced;
  647 |   }
  648 | 
  649 |   /**
  650 |    * Verifica se uma pasta do Drive tem uma playlist sincronizada.
  651 |    */
  652 |   getSyncedPlaylistForFolder(folderId: string): SyncedPlaylist | null {
  653 |     const playlists = this.getSyncedPlaylists();
  654 |     return playlists.find((p) => p.folderId === folderId) ?? null;
  655 |   }
  656 | 
  657 |   // --- Gerenciamento de Token (localStorage) ---
  658 | 
  659 |   private TOKEN_KEY = "llama-player-drive-token";
  660 | 
  661 |   private storeToken(token: string): void {
  662 |     try {
  663 |       localStorage.setItem(this.TOKEN_KEY, token);
  664 |     } catch {
  665 |       // localStorage pode não estar disponível
  666 |     }
  667 |   }
  668 | 
  669 |   private getStoredToken(): string | null {
  670 |     try {
  671 |       return localStorage.getItem(this.TOKEN_KEY);
  672 |     } catch {
  673 |       return null;
  674 |     }
  675 |   }
  676 | 
  677 |   private clearToken(): void {
  678 |     try {
  679 |       localStorage.removeItem(this.TOKEN_KEY);
  680 |     } catch {
  681 |       // Ignora
  682 |     }
  683 |   }
  684 | 
  685 |   /**
  686 |    * Verifica se o usuário está autenticado.
  687 |    */
  688 |   isAuthenticated(): boolean {
  689 |     return this.accessToken !== null;
  690 |   }
  691 | 
  692 |   /**
  693 |    * Retorna o token de acesso atual.
  694 |    */
  695 |   getAccessToken(): string | null {
  696 |     return this.accessToken;
  697 |   }
  698 | }
