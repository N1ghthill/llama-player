    1 | /* 🦙 Llama Player - Winamp Nostalgic Theme */
    2 | 
    3 | :root {
    4 |   --winamp-bg: #1a1a2e;
    5 |   --winamp-primary: #2d2d4a;
    6 |   --winamp-secondary: #3a3a5c;
    7 |   --winamp-accent: #00ff88;
    8 |   --winamp-accent-dim: #00aa55;
    9 |   --winamp-highlight: #ff6b9d;
   10 |   --winamp-text: #e0e0e0;
   11 |   --winamp-text-dim: #8888aa;
   12 |   --winamp-border: #4a4a6a;
   13 |   --winamp-progress-bg: #0d0d1a;
   14 |   --winamp-progress-fill: linear-gradient(90deg, #00ff88, #00ccff);
   15 |   --winamp-shadow: rgba(0, 0, 0, 0.6);
   16 |   --font-mono: "Courier New", monospace;
   17 |   --title-bar-height: 32px;
   18 |   --status-bar-height: 28px;
   19 |   --border-radius: 4px;
   20 | }
   21 | 
   22 | * {
   23 |   margin: 0;
   24 |   padding: 0;
   25 |   box-sizing: border-box;
   26 | }
   27 | 
   28 | body {
   29 |   font-family: var(--font-mono);
   30 |   background: radial-gradient(ellipse at center, #1a1a2e 0%, #0a0a14 100%);
   31 |   color: var(--winamp-text);
   32 |   min-height: 100vh;
   33 |   display: flex;
   34 |   justify-content: center;
   35 |   align-items: center;
   36 | }
   37 | 
   38 | #root {
   39 |   width: 100%;
   40 |   max-width: 480px;
   41 |   padding: 16px;
   42 | }
   43 | 
   44 | /* ===== App Container ===== */
   45 | 
   46 | .app {
   47 |   background: var(--winamp-bg);
   48 |   border: 2px solid var(--winamp-border);
   49 |   border-radius: var(--border-radius);
   50 |   overflow: hidden;
   51 |   box-shadow: 0 8px 32px var(--winamp-shadow);
   52 | }
   53 | 
   54 | /* ===== Title Bar ===== */
   55 | 
   56 | .title-bar {
   57 |   display: flex;
   58 |   align-items: center;
   59 |   justify-content: space-between;
   60 |   height: var(--title-bar-height);
   61 |   background: linear-gradient(90deg, var(--winamp-primary), var(--winamp-secondary));
   62 |   border-bottom: 1px solid var(--winamp-border);
   63 |   padding: 0 8px;
   64 |   user-select: none;
   65 | }
   66 | 
   67 | .title-bar-text {
   68 |   font-size: 12px;
   69 |   font-weight: bold;
   70 |   color: var(--winamp-accent);
   71 |   text-shadow: 0 0 8px rgba(0, 255, 136, 0.3);
   72 | }
   73 | 
   74 | .title-bar-controls {
   75 |   display: flex;
   76 |   gap: 4px;
   77 | }
   78 | 
   79 | .title-bar-controls button {
   80 |   width: 20px;
   81 |   height: 18px;
   82 |   border: 1px solid var(--winamp-border);
   83 |   border-radius: 2px;
   84 |   background: var(--winamp-primary);
   85 |   color: var(--winamp-text);
   86 |   font-size: 10px;
   87 |   cursor: pointer;
   88 |   display: flex;
   89 |   align-items: center;
   90 |   justify-content: center;
   91 |   transition: background 0.15s;
   92 | }
   93 | 
   94 | .title-bar-controls button:hover {
   95 |   background: var(--winamp-secondary);
   96 | }
   97 | 
   98 | .close-btn:hover {
   99 |   background: var(--winamp-highlight);
  100 |   color: #fff;
  101 | }
  102 | 
  103 | /* ===== Main Content ===== */
  104 | 
  105 | .main-content {
  106 |   padding: 12px;
  107 |   display: flex;
  108 |   flex-direction: column;
  109 |   gap: 12px;
  110 | }
  111 | 
  112 | /* ===== Toolbar ===== */
  113 | 
  114 | .toolbar {
  115 |   display: flex;
  116 |   gap: 6px;
  117 | }
  118 | 
  119 | .toolbar-btn {
  120 |   display: flex;
  121 |   align-items: center;
  122 |   gap: 4px;
  123 |   padding: 4px 10px;
  124 |   font-family: var(--font-mono);
  125 |   font-size: 11px;
  126 |   border: 1px solid var(--winamp-border);
  127 |   border-radius: var(--border-radius);
  128 |   background: var(--winamp-primary);
  129 |   color: var(--winamp-text);
  130 |   cursor: pointer;
  131 |   transition: all 0.15s;
  132 | }
  133 | 
  134 | .toolbar-btn:hover {
  135 |   background: var(--winamp-secondary);
  136 |   border-color: var(--winamp-accent-dim);
  137 | }
  138 | 
  139 | /* ===== Playlist Panel ===== */
  140 | 
  141 | .playlist-panel {
  142 |   border: 1px solid var(--winamp-border);
  143 |   border-radius: var(--border-radius);
  144 |   background: var(--winamp-primary);
  145 |   overflow: hidden;
  146 | }
  147 | 
  148 | .panel-header {
  149 |   background: linear-gradient(90deg, var(--winamp-secondary), var(--winamp-primary));
  150 |   padding: 6px 10px;
  151 |   font-size: 11px;
  152 |   font-weight: bold;
  153 |   color: var(--winamp-accent);
  154 |   letter-spacing: 1px;
  155 |   border-bottom: 1px solid var(--winamp-border);
  156 | }
  157 | 
  158 | .playlist {
  159 |   list-style: none;
  160 |   max-height: 200px;
  161 |   overflow-y: auto;
  162 | }
  163 | 
  164 | .playlist-item {
  165 |   display: flex;
  166 |   align-items: center;
  167 |   gap: 6px;
  168 |   padding: 6px 10px;
  169 |   font-size: 12px;
  170 |   cursor: grab;
  171 |   transition: background 0.1s, opacity 0.1s;
  172 |   border-bottom: 1px solid rgba(74, 74, 106, 0.3);
  173 |   user-select: none;
  174 | }
  175 | 
  176 | .playlist-item:active {
  177 |   cursor: grabbing;
  178 | }
  179 | 
  180 | .playlist-item.dragging {
  181 |   opacity: 0.4;
  182 |   background: var(--winamp-secondary);
  183 | }
  184 | 
  185 | .playlist-item.drag-over {
  186 |   border-top: 2px solid var(--winamp-accent);
  187 |   background: rgba(0, 255, 136, 0.08);
  188 | }
  189 | 
  190 | .playlist-item:last-child {
  191 |   border-bottom: none;
  192 | }
  193 | 
  194 | .playlist-item:hover {
  195 |   background: var(--winamp-secondary);
  196 | }
  197 | 
  198 | .playlist-item.active {
  199 |   background: var(--winamp-secondary);
  200 |   color: var(--winamp-accent);
  201 |   border-left: 3px solid var(--winamp-accent);
  202 |   padding-left: 7px;
  203 | }
  204 | 
  205 | .playlist-empty {
  206 |   color: var(--winamp-text-dim);
  207 |   cursor: default;
  208 |   font-style: italic;
  209 | }
  210 | 
  211 | .playlist-item-drag-handle {
  212 |   width: 12px;
  213 |   text-align: center;
  214 |   font-size: 10px;
  215 |   flex-shrink: 0;
  216 |   color: var(--winamp-text-dim);
  217 |   cursor: grab;
  218 |   opacity: 0.5;
  219 |   transition: opacity 0.15s;
  220 | }
  221 | 
  222 | .playlist-item:hover .playlist-item-drag-handle {
  223 |   opacity: 1;
  224 | }
  225 | 
  226 | .playlist-item-icon {
  227 |   width: 16px;
  228 |   text-align: center;
  229 |   font-size: 10px;
  230 |   flex-shrink: 0;
  231 | }
  232 | 
  233 | .playlist-item-title {
  234 |   flex: 1;
  235 |   white-space: nowrap;
  236 |   overflow: hidden;
  237 |   text-overflow: ellipsis;
  238 | }
  239 | 
  240 | .playlist-item-artist {
  241 |   color: var(--winamp-text-dim);
  242 |   font-size: 10px;
  243 |   max-width: 100px;
  244 |   white-space: nowrap;
  245 |   overflow: hidden;
  246 |   text-overflow: ellipsis;
  247 | }
  248 | 
  249 | .playlist-item-duration {
  250 |   color: var(--winamp-text-dim);
  251 |   font-size: 10px;
  252 |   flex-shrink: 0;
  253 |   margin-left: auto;
  254 | }
  255 | 
  256 | .panel-footer {
  257 |   display: flex;
  258 |   justify-content: space-between;
  259 |   padding: 4px 10px;
  260 |   font-size: 10px;
  261 |   color: var(--winamp-text-dim);
  262 |   border-top: 1px solid var(--winamp-border);
  263 |   background: rgba(0, 0, 0, 0.2);
  264 | }
  265 | 
  266 | /* ===== Player Controls ===== */
  267 | 
  268 | .player-controls {
  269 |   display: flex;
  270 |   flex-direction: column;
  271 |   gap: 8px;
  272 | }
  273 | 
  274 | .now-playing {
  275 |   display: flex;
  276 |   align-items: center;
  277 |   gap: 10px;
  278 |   padding: 6px 0;
  279 | }
  280 | 
  281 | .album-art {
  282 |   width: 48px;
  283 |   height: 48px;
  284 |   border-radius: var(--border-radius);
  285 |   border: 1px solid var(--winamp-border);
  286 |   object-fit: cover;
  287 |   flex-shrink: 0;
  288 |   background: var(--winamp-primary);
  289 | }
  290 | 
  291 | .now-playing-info {
  292 |   flex: 1;
  293 |   min-width: 0;
  294 | }
  295 | 
  296 | .track-title {
  297 |   display: block;
  298 |   font-size: 14px;
  299 |   font-weight: bold;
  300 |   color: var(--winamp-text);
  301 |   white-space: nowrap;
  302 |   overflow: hidden;
  303 |   text-overflow: ellipsis;
  304 | }
  305 | 
  306 | .track-artist {
  307 |   display: block;
  308 |   font-size: 11px;
  309 |   color: var(--winamp-text-dim);
  310 |   margin-top: 2px;
  311 | }
  312 | 
  313 | .track-album {
  314 |   display: block;
  315 |   font-size: 10px;
  316 |   color: var(--winamp-text-dim);
  317 |   margin-top: 1px;
  318 |   opacity: 0.7;
  319 | }
  320 | 
  321 | .controls {
  322 |   display: flex;
  323 |   justify-content: center;
  324 |   gap: 8px;
  325 | }
  326 | 
  327 | .ctrl-btn {
  328 |   width: 40px;
  329 |   height: 32px;
  330 |   border: 1px solid var(--winamp-border);
  331 |   border-radius: var(--border-radius);
  332 |   background: var(--winamp-primary);
  333 |   color: var(--winamp-text);
  334 |   font-size: 16px;
  335 |   cursor: pointer;
  336 |   display: flex;
  337 |   align-items: center;
  338 |   justify-content: center;
  339 |   transition: all 0.15s;
  340 | }
  341 | 
  342 | .ctrl-btn:hover {
  343 |   background: var(--winamp-secondary);
  344 |   border-color: var(--winamp-accent-dim);
  345 | }
  346 | 
  347 | .ctrl-btn:active {
  348 |   transform: scale(0.95);
  349 | }
  350 | 
  351 | .play-btn {
  352 |   width: 48px;
  353 |   background: var(--winamp-accent-dim);
  354 |   border-color: var(--winamp-accent);
  355 |   color: #fff;
  356 | }
  357 | 
  358 | .play-btn:hover {
  359 |   background: var(--winamp-accent);
  360 |   box-shadow: 0 0 12px rgba(0, 255, 136, 0.3);
  361 | }
  362 | 
  363 | .shuffle-btn {
  364 |   font-size: 14px;
  365 |   opacity: 0.6;
  366 |   transition: opacity 0.2s, background 0.2s, box-shadow 0.2s;
  367 | }
  368 | 
  369 | .shuffle-btn.active {
  370 |   opacity: 1;
  371 |   background: #1b5e20;
  372 |   border-color: #4caf50;
  373 |   color: #fff;
  374 |   box-shadow: 0 0 12px rgba(76, 175, 80, 0.5);
  375 | }
  376 | 
  377 | .shuffle-btn.active:hover {
  378 |   background: #2e7d32;
  379 |   box-shadow: 0 0 18px rgba(76, 175, 80, 0.7);
  380 | }
  381 | 
  382 | /* ===== Progress Bar ===== */
  383 | 
  384 | .progress-bar {
  385 |   display: flex;
  386 |   align-items: center;
  387 |   gap: 8px;
  388 |   padding: 4px 0;
  389 | }
  390 | 
  391 | .progress-track {
  392 |   flex: 1;
  393 |   height: 8px;
  394 |   background: var(--winamp-progress-bg);
  395 |   border: 1px solid var(--winamp-border);
  396 |   border-radius: 4px;
  397 |   cursor: pointer;
  398 |   position: relative;
  399 |   overflow: hidden;
  400 | }
  401 | 
  402 | .progress-thumb {
  403 |   height: 100%;
  404 |   background: var(--winamp-progress-fill);
  405 |   border-radius: 3px;
  406 |   transition: width 0.1s linear;
  407 |   position: relative;
  408 | }
  409 | 
  410 | .progress-thumb::after {
  411 |   content: "";
  412 |   position: absolute;
  413 |   right: -2px;
  414 |   top: -2px;
  415 |   width: 8px;
  416 |   height: 12px;
  417 |   background: var(--winamp-text);
  418 |   border-radius: 2px;
  419 |   opacity: 0;
  420 |   transition: opacity 0.15s;
  421 | }
  422 | 
  423 | .progress-track:hover .progress-thumb::after {
  424 |   opacity: 1;
  425 | }
  426 | 
  427 | .time {
  428 |   font-size: 11px;
  429 |   color: var(--winamp-text-dim);
  430 |   white-space: nowrap;
  431 |   min-width: 80px;
  432 |   text-align: right;
  433 | }
  434 | 
  435 | /* ===== Status Bar ===== */
  436 | 
  437 | .status-bar {
  438 |   display: flex;
  439 |   align-items: center;
  440 |   justify-content: space-between;
  441 |   height: var(--status-bar-height);
  442 |   background: linear-gradient(90deg, var(--winamp-primary), var(--winamp-secondary));
  443 |   border-top: 1px solid var(--winamp-border);
  444 |   padding: 0 10px;
  445 |   font-size: 11px;
  446 |   color: var(--winamp-text-dim);
  447 | }
  448 | 
  449 | .volume-control {
  450 |   display: flex;
  451 |   align-items: center;
  452 |   gap: 6px;
  453 | }
  454 | 
  455 | .volume-icon {
  456 |   font-size: 12px;
  457 | }
  458 | 
  459 | .volume-slider {
  460 |   width: 80px;
  461 |   height: 4px;
  462 |   -webkit-appearance: none;
  463 |   appearance: none;
  464 |   background: var(--winamp-progress-bg);
  465 |   border: 1px solid var(--winamp-border);
  466 |   border-radius: 2px;
  467 |   outline: none;
  468 |   cursor: pointer;
  469 | }
  470 | 
  471 | .volume-slider::-webkit-slider-thumb {
  472 |   -webkit-appearance: none;
  473 |   width: 12px;
  474 |   height: 12px;
  475 |   background: var(--winamp-accent);
  476 |   border: 1px solid var(--winamp-accent-dim);
  477 |   border-radius: 2px;
  478 |   cursor: pointer;
  479 | }
  480 | 
  481 | .volume-slider::-moz-range-thumb {
  482 |   width: 12px;
  483 |   height: 12px;
  484 |   background: var(--winamp-accent);
  485 |   border: 1px solid var(--winamp-accent-dim);
  486 |   border-radius: 2px;
  487 |   cursor: pointer;
  488 | }
  489 | 
  490 | /* ===== Scrollbar ===== */
  491 | 
  492 | ::-webkit-scrollbar {
  493 |   width: 8px;
  494 | }
  495 | 
  496 | ::-webkit-scrollbar-track {
  497 |   background: var(--winamp-bg);
  498 |   border-left: 1px solid var(--winamp-border);
  499 | }
  500 | 
  501 | ::-webkit-scrollbar-thumb {
  502 |   background: var(--winamp-primary);
  503 |   border: 1px solid var(--winamp-border);
  504 |   border-radius: 2px;
  505 | }
  506 | 
  507 | ::-webkit-scrollbar-thumb:hover {
  508 |   background: var(--winamp-secondary);
  509 | }
  510 | 
  511 | /* ===== Toolbar Active Button ===== */
  512 | 
  513 | .toolbar-btn-active {
  514 |   background: var(--winamp-accent-dim) !important;
  515 |   border-color: var(--winamp-accent) !important;
  516 |   color: #fff !important;
  517 | }
  518 | 
  519 | /* ===== Google Drive Panel ===== */
  520 | 
  521 | .drive-panel {
  522 |   border: 1px solid var(--winamp-border);
  523 |   border-radius: var(--border-radius);
  524 |   background: var(--winamp-primary);
  525 |   overflow: hidden;
  526 | }
  527 | 
  528 | .drive-panel .panel-header {
  529 |   display: flex;
  530 |   align-items: center;
  531 |   justify-content: space-between;
  532 | }
  533 | 
  534 | .drive-user-info {
  535 |   display: flex;
  536 |   align-items: center;
  537 |   gap: 6px;
  538 |   font-size: 10px;
  539 |   font-weight: normal;
  540 |   color: var(--winamp-text-dim);
  541 | }
  542 | 
  543 | .drive-user-avatar {
  544 |   width: 18px;
  545 |   height: 18px;
  546 |   border-radius: 50%;
  547 |   border: 1px solid var(--winamp-border);
  548 | }
  549 | 
  550 | .drive-user-name {
  551 |   max-width: 100px;
  552 |   white-space: nowrap;
  553 |   overflow: hidden;
  554 |   text-overflow: ellipsis;
  555 | }
  556 | 
  557 | .drive-logout-btn {
  558 |   width: 18px;
  559 |   height: 18px;
  560 |   border: 1px solid var(--winamp-border);
  561 |   border-radius: 2px;
  562 |   background: transparent;
  563 |   color: var(--winamp-text-dim);
  564 |   font-size: 9px;
  565 |   cursor: pointer;
  566 |   display: flex;
  567 |   align-items: center;
  568 |   justify-content: center;
  569 |   transition: all 0.15s;
  570 | }
  571 | 
  572 | .drive-logout-btn:hover {
  573 |   background: var(--winamp-highlight);
  574 |   color: #fff;
  575 |   border-color: var(--winamp-highlight);
  576 | }
  577 | 
  578 | /* Login */
  579 | .drive-login {
  580 |   padding: 20px 16px;
  581 |   text-align: center;
  582 |   display: flex;
  583 |   flex-direction: column;
  584 |   align-items: center;
  585 |   gap: 12px;
  586 | }
  587 | 
  588 | .drive-login-text {
  589 |   font-size: 12px;
  590 |   color: var(--winamp-text-dim);
  591 |   line-height: 1.5;
  592 | }
  593 | 
  594 | .drive-login-btn {
  595 |   display: flex;
  596 |   align-items: center;
  597 |   gap: 8px;
  598 |   padding: 8px 20px;
  599 |   font-family: var(--font-mono);
  600 |   font-size: 13px;
  601 |   font-weight: bold;
  602 |   border: 1px solid var(--winamp-accent);
  603 |   border-radius: var(--border-radius);
  604 |   background: var(--winamp-accent-dim);
  605 |   color: #fff;
  606 |   cursor: pointer;
  607 |   transition: all 0.15s;
  608 | }
  609 | 
  610 | .drive-login-btn:hover {
  611 |   background: var(--winamp-accent);
  612 |   box-shadow: 0 0 12px rgba(0, 255, 136, 0.3);
  613 | }
  614 | 
  615 | .drive-login-btn:active {
  616 |   transform: scale(0.97);
  617 | }
  618 | 
  619 | /* Config warning */
  620 | .drive-config-warning {
  621 |   padding: 16px;
  622 |   text-align: center;
  623 |   font-size: 12px;
  624 |   color: var(--winamp-text-dim);
  625 |   line-height: 1.6;
  626 | }
  627 | 
  628 | .drive-config-warning p {
  629 |   margin-bottom: 8px;
  630 | }
  631 | 
  632 | .drive-config-hint {
  633 |   font-size: 11px;
  634 |   color: var(--winamp-text-dim);
  635 |   opacity: 0.8;
  636 | }
  637 | 
  638 | .drive-config-code {
  639 |   background: var(--winamp-progress-bg);
  640 |   border: 1px solid var(--winamp-border);
  641 |   border-radius: var(--border-radius);
  642 |   padding: 8px 12px;
  643 |   font-size: 11px;
  644 |   color: var(--winamp-accent);
  645 |   text-align: left;
  646 |   overflow-x: auto;
  647 |   margin: 8px 0;
  648 | }
  649 | 
  650 | .drive-config-warning a {
  651 |   color: var(--winamp-accent);
  652 |   text-decoration: underline;
  653 | }
  654 | 
  655 | .drive-config-warning a:hover {
  656 |   color: var(--winamp-highlight);
  657 | }
  658 | 
  659 | /* Loading */
  660 | .drive-loading {
  661 |   display: flex;
  662 |   align-items: center;
  663 |   justify-content: center;
  664 |   gap: 8px;
  665 |   padding: 24px 16px;
  666 |   font-size: 12px;
  667 |   color: var(--winamp-text-dim);
  668 | }
  669 | 
  670 | .drive-spinner {
  671 |   display: inline-block;
  672 |   width: 14px;
  673 |   height: 14px;
  674 |   border: 2px solid var(--winamp-border);
  675 |   border-top-color: var(--winamp-accent);
  676 |   border-radius: 50%;
  677 |   animation: drive-spin 0.6s linear infinite;
  678 | }
  679 | 
  680 | @keyframes drive-spin {
  681 |   to {
  682 |     transform: rotate(360deg);
  683 |   }
  684 | }
  685 | 
  686 | /* Error */
  687 | .drive-error {
  688 |   font-size: 11px;
  689 |   color: var(--winamp-highlight);
  690 |   margin-top: 4px;
  691 | }
  692 | 
  693 | .drive-error-bar {
  694 |   padding: 6px 10px;
  695 |   font-size: 10px;
  696 |   color: var(--winamp-highlight);
  697 |   background: rgba(255, 107, 157, 0.1);
  698 |   border-top: 1px solid var(--winamp-border);
  699 | }
  700 | 
  701 | /* Breadcrumbs */
  702 | .drive-breadcrumbs {
  703 |   display: flex;
  704 |   align-items: center;
  705 |   gap: 2px;
  706 |   padding: 4px 10px;
  707 |   background: rgba(0, 0, 0, 0.15);
  708 |   border-bottom: 1px solid var(--winamp-border);
  709 |   overflow-x: auto;
  710 |   white-space: nowrap;
  711 | }
  712 | 
  713 | .drive-breadcrumb-btn {
  714 |   background: none;
  715 |   border: none;
  716 |   color: var(--winamp-accent);
  717 |   font-family: var(--font-mono);
  718 |   font-size: 11px;
  719 |   cursor: pointer;
  720 |   padding: 2px 4px;
  721 |   border-radius: 2px;
  722 |   transition: background 0.1s;
  723 | }
  724 | 
  725 | .drive-breadcrumb-btn:hover {
  726 |   background: rgba(0, 255, 136, 0.1);
  727 | }
  728 | 
  729 | .drive-breadcrumb-sep {
  730 |   color: var(--winamp-text-dim);
  731 |   font-size: 11px;
  732 |   margin: 0 1px;
  733 | }
  734 | 
  735 | .drive-breadcrumb-current {
  736 |   color: var(--winamp-text);
  737 |   font-size: 11px;
  738 |   padding: 2px 4px;
  739 | }
  740 | 
  741 | /* Search */
  742 | .drive-search {
  743 |   display: flex;
  744 |   gap: 4px;
  745 |   padding: 6px 10px;
  746 |   border-bottom: 1px solid var(--winamp-border);
  747 | }
  748 | 
  749 | .drive-search-input {
  750 |   flex: 1;
  751 |   padding: 4px 8px;
  752 |   font-family: var(--font-mono);
  753 |   font-size: 11px;
  754 |   background: var(--winamp-progress-bg);
  755 |   border: 1px solid var(--winamp-border);
  756 |   border-radius: var(--border-radius);
  757 |   color: var(--winamp-text);
  758 |   outline: none;
  759 | }
  760 | 
  761 | .drive-search-input:focus {
  762 |   border-color: var(--winamp-accent-dim);
  763 | }
  764 | 
  765 | .drive-search-input::placeholder {
  766 |   color: var(--winamp-text-dim);
  767 |   opacity: 0.6;
  768 | }
  769 | 
  770 | .drive-search-btn {
  771 |   width: 28px;
  772 |   height: 26px;
  773 |   border: 1px solid var(--winamp-border);
  774 |   border-radius: var(--border-radius);
  775 |   background: var(--winamp-primary);
  776 |   color: var(--winamp-text);
  777 |   font-size: 12px;
  778 |   cursor: pointer;
  779 |   display: flex;
  780 |   align-items: center;
  781 |   justify-content: center;
  782 |   transition: all 0.15s;
  783 | }
  784 | 
  785 | .drive-search-btn:hover {
  786 |   background: var(--winamp-secondary);
  787 |   border-color: var(--winamp-accent-dim);
  788 | }
  789 | 
  790 | /* Actions bar */
  791 | .drive-actions {
  792 |   display: flex;
  793 |   align-items: center;
  794 |   justify-content: space-between;
  795 |   padding: 4px 10px;
  796 |   border-bottom: 1px solid var(--winamp-border);
  797 |   background: rgba(0, 0, 0, 0.1);
  798 | }
  799 | 
  800 | .drive-item-count {
  801 |   font-size: 10px;
  802 |   color: var(--winamp-text-dim);
  803 | }
  804 | 
  805 | .drive-action-btns {
  806 |   display: flex;
  807 |   gap: 4px;
  808 | }
  809 | 
  810 | .drive-action-btn {
  811 |   padding: 2px 8px;
  812 |   font-family: var(--font-mono);
  813 |   font-size: 10px;
  814 |   border: 1px solid var(--winamp-border);
  815 |   border-radius: var(--border-radius);
  816 |   background: var(--winamp-primary);
  817 |   color: var(--winamp-text);
  818 |   cursor: pointer;
  819 |   transition: all 0.15s;
  820 | }
  821 | 
  822 | .drive-action-btn:hover {
  823 |   background: var(--winamp-secondary);
  824 |   border-color: var(--winamp-accent-dim);
  825 | }
  826 | 
  827 | .drive-action-btn-primary {
  828 |   background: var(--winamp-accent-dim);
  829 |   border-color: var(--winamp-accent);
  830 |   color: #fff;
  831 | }
  832 | 
  833 | .drive-action-btn-primary:hover {
  834 |   background: var(--winamp-accent);
  835 |   box-shadow: 0 0 8px rgba(0, 255, 136, 0.25);
  836 | }
  837 | 
  838 | /* File list */
  839 | .drive-file-list {
  840 |   max-height: 240px;
  841 |   overflow-y: auto;
  842 | }
  843 | 
  844 | .drive-empty {
  845 |   padding: 20px 16px;
  846 |   text-align: center;
  847 |   font-size: 11px;
  848 |   color: var(--winamp-text-dim);
  849 |   font-style: italic;
  850 | }
  851 | 
  852 | .drive-items {
  853 |   list-style: none;
  854 | }
  855 | 
  856 | .drive-item {
  857 |   display: flex;
  858 |   align-items: center;
  859 |   gap: 6px;
  860 |   padding: 5px 10px;
  861 |   font-size: 11px;
  862 |   cursor: pointer;
  863 |   transition: background 0.1s;
  864 |   border-bottom: 1px solid rgba(74, 74, 106, 0.2);
  865 |   user-select: none;
  866 | }
  867 | 
  868 | .drive-item:last-child {
  869 |   border-bottom: none;
  870 | }
  871 | 
  872 | .drive-item:hover {
  873 |   background: var(--winamp-secondary);
  874 | }
  875 | 
  876 | .drive-item-folder {
  877 |   cursor: pointer;
  878 |   color: var(--winamp-accent);
  879 | }
  880 | 
  881 | .drive-item-folder:hover {
  882 |   background: rgba(0, 255, 136, 0.08);
  883 | }
  884 | 
  885 | .drive-item-other {
  886 |   cursor: default;
  887 |   opacity: 0.5;
  888 | }
  889 | 
  890 | .drive-item-audio {
  891 |   cursor: pointer;
  892 | }
  893 | 
  894 | .drive-item-selected {
  895 |   background: rgba(0, 255, 136, 0.1);
  896 |   border-left: 3px solid var(--winamp-accent);
  897 |   padding-left: 7px;
  898 | }
  899 | 
  900 | .drive-item-selected:hover {
  901 |   background: rgba(0, 255, 136, 0.15);
  902 | }
  903 | 
  904 | .drive-item-checkbox {
  905 |   width: 14px;
  906 |   text-align: center;
  907 |   font-size: 12px;
  908 |   flex-shrink: 0;
  909 |   color: var(--winamp-accent);
  910 | }
  911 | 
  912 | .drive-item-icon {
  913 |   width: 16px;
  914 |   text-align: center;
  915 |   font-size: 12px;
  916 |   flex-shrink: 0;
  917 | }
  918 | 
  919 | .drive-item-name {
  920 |   flex: 1;
  921 |   white-space: nowrap;
  922 |   overflow: hidden;
  923 |   text-overflow: ellipsis;
  924 | }
  925 | 
  926 | .drive-item-size {
  927 |   color: var(--winamp-text-dim);
  928 |   font-size: 10px;
  929 |   flex-shrink: 0;
  930 |   min-width: 50px;
  931 |   text-align: right;
  932 | }
  933 | 
  934 | .drive-item-date {
  935 |   color: var(--winamp-text-dim);
  936 |   font-size: 10px;
  937 |   flex-shrink: 0;
  938 |   min-width: 70px;
  939 |   text-align: right;
  940 | }
  941 | 
  942 | /* ===== Synced Playlists ===== */
  943 | 
  944 | .drive-synced-section {
  945 |   border-top: 1px solid var(--winamp-border);
  946 |   background: rgba(0, 0, 0, 0.1);
  947 | }
  948 | 
  949 | .drive-synced-toggle {
  950 |   width: 100%;
  951 |   padding: 6px 10px;
  952 |   font-family: var(--font-mono);
  953 |   font-size: 10px;
  954 |   text-align: left;
  955 |   background: none;
  956 |   border: none;
  957 |   color: var(--winamp-accent);
  958 |   cursor: pointer;
  959 |   transition: background 0.1s;
  960 | }
  961 | 
  962 | .drive-synced-toggle:hover {
  963 |   background: rgba(0, 255, 136, 0.08);
  964 | }
  965 | 
  966 | .drive-synced-list {
  967 |   list-style: none;
  968 |   max-height: 120px;
  969 |   overflow-y: auto;
  970 | }
  971 | 
  972 | .drive-synced-item {
  973 |   display: flex;
  974 |   align-items: center;
  975 |   gap: 6px;
  976 |   padding: 4px 10px;
  977 |   font-size: 10px;
  978 |   border-bottom: 1px solid rgba(74, 74, 106, 0.15);
  979 | }
  980 | 
  981 | .drive-synced-item:last-child {
  982 |   border-bottom: none;
  983 | }
  984 | 
  985 | .drive-synced-icon {
  986 |   font-size: 11px;
  987 |   flex-shrink: 0;
  988 | }
  989 | 
  990 | .drive-synced-name {
  991 |   flex: 1;
  992 |   white-space: nowrap;
  993 |   overflow: hidden;
  994 |   text-overflow: ellipsis;
  995 |   color: var(--winamp-text);
  996 | }
  997 | 
  998 | .drive-synced-meta {
  999 |   color: var(--winamp-text-dim);
 1000 |   font-size: 9px;
 1001 |   flex-shrink: 0;
 1002 | }
 1003 | 
 1004 | .drive-synced-load-btn,
 1005 | .drive-synced-remove-btn {
 1006 |   width: 18px;
 1007 |   height: 16px;
 1008 |   border: 1px solid var(--winamp-border);
 1009 |   border-radius: 2px;
 1010 |   background: transparent;
 1011 |   font-size: 9px;
 1012 |   cursor: pointer;
 1013 |   display: flex;
 1014 |   align-items: center;
 1015 |   justify-content: center;
 1016 |   transition: all 0.15s;
 1017 |   flex-shrink: 0;
 1018 | }
 1019 | 
 1020 | .drive-synced-load-btn:hover {
 1021 |   background: var(--winamp-accent-dim);
 1022 |   border-color: var(--winamp-accent);
 1023 |   color: #fff;
 1024 | }
 1025 | 
 1026 | .drive-synced-remove-btn:hover {
 1027 |   background: var(--winamp-highlight);
 1028 |   border-color: var(--winamp-highlight);
 1029 |   color: #fff;
 1030 | }
 1031 | 
 1032 | /* ===== Drag & Drop de Arquivos ===== */
 1033 | 
 1034 | .playlist-panel.playlist-drag-over {
 1035 |   border-color: var(--winamp-accent);
 1036 |   box-shadow: inset 0 0 20px rgba(0, 255, 136, 0.15);
 1037 |   transition: all 0.2s;
 1038 | }
 1039 | 
 1040 | .playlist-drop-indicator {
 1041 |   padding: 16px;
 1042 |   text-align: center;
 1043 |   font-size: 12px;
 1044 |   color: var(--winamp-accent);
 1045 |   background: rgba(0, 255, 136, 0.08);
 1046 |   border-bottom: 1px solid var(--winamp-accent);
 1047 |   animation: pulse-glow 1.5s ease-in-out infinite;
 1048 | }
 1049 | 
 1050 | @keyframes pulse-glow {
 1051 |   0%, 100% {
 1052 |     opacity: 0.7;
 1053 |   }
 1054 |   50% {
 1055 |     opacity: 1;
 1056 |   }
 1057 | }
 1058 | 
 1059 | /* ===== Audio Visualizer ===== */
 1060 | 
 1061 | .audio-visualizer {
 1062 |   position: relative;
 1063 |   background: var(--winamp-progress-bg);
 1064 |   border: 1px solid var(--winamp-border);
 1065 |   border-radius: var(--border-radius);
 1066 |   overflow: hidden;
 1067 | }
 1068 | 
 1069 | .audio-visualizer-canvas {
 1070 |   display: block;
 1071 |   width: 100%;
 1072 |   height: auto;
 1073 |   aspect-ratio: 480 / 120;
 1074 | }
 1075 | 
 1076 | .audio-visualizer-toggle {
 1077 |   position: absolute;
 1078 |   top: 4px;
 1079 |   right: 4px;
 1080 |   width: 24px;
 1081 |   height: 22px;
 1082 |   border: 1px solid var(--winamp-border);
 1083 |   border-radius: 2px;
 1084 |   background: rgba(26, 26, 46, 0.8);
 1085 |   color: var(--winamp-text);
 1086 |   font-size: 12px;
 1087 |   cursor: pointer;
 1088 |   display: flex;
 1089 |   align-items: center;
 1090 |   justify-content: center;
 1091 |   transition: background 0.15s;
 1092 |   opacity: 0.6;
 1093 |   line-height: 1;
 1094 | }
 1095 | 
 1096 | .audio-visualizer-toggle:hover {
 1097 |   background: var(--winamp-secondary);
 1098 |   opacity: 1;
 1099 | }
 1100 | 
 1101 | /* ===== Selection ===== */
 1102 | 
 1103 | ::selection {
 1104 |   background: var(--winamp-accent);
 1105 |   color: var(--winamp-bg);
 1106 | }
 1107 | 