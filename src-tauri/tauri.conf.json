{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Llama Player",
  "version": "0.1.1",
  "identifier": "com.llamaplayer.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "🦙 Llama Player",
        "width": 960,
        "height": 720,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; media-src 'self' data: asset:; connect-src 'self' asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libglib2.0-0",
          "libcairo2",
          "libgdk-pixbuf2.0-0",
          "libpango-1.0-0",
          "libatk1.0-0",
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNzcwMEM0RThENTJCQ0YKUldUUEs5WG94QUIzUVRnOFVMMEpXZnhhNThkZ0ZRMUYvYWQ1cGN2MngvN3EwM0lBNEdNaUJXbzgK",
      "endpoints": [
        "https://github.com/N1ghthill/llama-player/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
