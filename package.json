{
  "name": "llama-player",
  "private": true,
  "version": "0.2.0",
  "description": "🎵 Llama Player - Um player de música local inspirado em players desktop clássicos",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:check": "tauri build --no-bundle",
    "desktop:build": "tauri build",
    "checksums": "node scripts/generate-checksums.mjs",
    "release:validate": "node scripts/validate-release-config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release:local": "npm run release:validate && npm run check && npm run build && npm run desktop:check"
  },
  "dependencies": {
    "jsmediatags": "^3.9.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^26.1.0",
    "typescript": "^5.5.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
